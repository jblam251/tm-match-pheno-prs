        cpus = 4
        memory = '16 GB'
        time = '00:30:00'
        maxForks = 2
        errorStrategy = 'ignore'
    }
}

process {
    withName: GENIDMAP {
        cpus = 8
        memory = '32 GB'
        time = '00:30:00'
        maxForks = 2
