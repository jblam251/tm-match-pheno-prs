params {
    type = "metabolomics"
    settings = "/net/topmed11/working/jblamer/id-checking/tm-match-pheno-prs/etc/match.settings.metabqtl.all.csv"
    traits = "/net/topmed11/working/jblamer/qc.xqtl/match/metab.phase2/traits/metab.qtl.2026.phase2.traits.txt"
    pgs = "/net/topmed11/working/jblamer/qc.xqtl/match/metab.phase2/pgs/metab.qtl.2026.phase2.conditional.freeze12c.prs.tsv.gz"
    omicsmap = "/net/fantasia/home/jblamer/misc/tm.data.freeze.sample.lists/TOPMed_Combined_Omics_SampleAttributes_DS_20260304.115113.wgs.frz.added.txt"
    scripts = "/net/topmed11/working/jblamer/id-checking/tm-match-pheno-prs/bin"
}

process {
    executor = 'slurm'
}

executor {
    queueSize = 6
}

process {
    withName: PHENO2PL {
        cpus = 4
        memory = '16 GB'
        time = '00:30:00'
        maxForks = 2
    }
}

process {
    withName: GENIDMAP {
        cpus = 8
        memory = '32 GB'
        time = '00:30:00'
        maxForks = 2
    }
}


process {
    withName: SUBSET_PRS {
        cpus = 2
        memory = '8 GB'
        time = '00:30:00'
        maxForks = 2
    }
}


process {
    withName: MATCH_PRS {
        cpus = 8
        memory = '32 GB'
        time = '00:30:00'
        maxForks = 2
    }
}
