params {
    type = "proteomics"
    settings = "/net/topmed11/working/jblamer/id-checking/tm-match-pheno-prs/etc/match.settings.pqtl.all.csv"
    pgs = "/net/topmed11/working/jblamer/qc.xqtl/match/pqtl/pgs/ukb_ppp_v2_sentinel_GeneNames.topmed_freeze12c_minDP0_cis.prs.tsv.gz"
    omicsmap = "/net/fantasia/home/jblamer/misc/tm.data.freeze.sample.lists/TOPMed_Combined_Omics_SampleAttributes_DS_20260304.115113.wgs.frz.added.txt"
    scripts = "/net/topmed11/working/jblamer/id-checking/tm-match-pheno-prs/bin"
}

process {
    executor = 'slurm'
}

executor {
    queueSize = 4
}

process {
    withName: PHENO2PL {
        cpus = 8
        memory = '32 GB'
        time = '02:00:00'
        maxForks = 2
    }
}

process {
    withName: GENIDMAP {
        cpus = 8
        memory = '32 GB'
        time = '00:30:00'
        maxForks = 2
    }
}


process {
    withName: SUBSET_PRS {
        cpus = 2
        memory = '8 GB'
        time = '00:15:00'
        maxForks = 2
    }
}


process {
    withName: MATCH_PRS {
        cpus = 8
        memory = '32 GB'
        time = '00:30:00'
        maxForks = 2
    }
}
